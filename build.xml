<?xml version="1.0"?>
<!-- 
    Build file for Online Banking Application
    Used with Apache Ant to compile and build the project
-->
<project name="OnlineBanking" default="build" basedir=".">

    <!-- Project Properties -->
    <property name="src" location="src" />
    <property name="build" location="build" />
    <property name="dist" location="dist" />
    <property name="web" location="web" />
    <property name="webcontent" location="WebContent" />

    <!-- Compilation Properties -->
    <property name="project.java.version" value="1.8" />
    <property name="debug" value="on" />
    <property name="deprecation" value="on" />

    <!-- Clean all build artifacts -->
    <target name="clean" description="Clean build directories">
        <delete dir="${build}" />
        <delete dir="${dist}" />
        <echo message="Build directories cleaned" />
    </target>

    <!-- Initialize build directories -->
    <target name="init" depends="clean">
        <mkdir dir="${build}" />
        <mkdir dir="${dist}" />
        <echo message="Build directories initialized" />
    </target>

    <!-- Compile Java source code -->
    <target name="compile" depends="init" description="Compile Java source files">
        <javac 
            srcdir="${src}" 
            destdir="${build}" 
            debug="${debug}" 
            deprecation="${deprecation}"
            source="${project.java.version}"
            target="${project.java.version}"
            includeAntRuntime="false">
            <classpath>
                <!-- MySQL JDBC Driver -->
                <fileset dir="lib">
                    <include name="*.jar" />
                </fileset>
            </classpath>
        </javac>
        <echo message="Compilation completed successfully" />
    </target>

    <!-- Build WAR file for deployment -->
    <target name="build" depends="compile" description="Build WAR file">
        <war destfile="${dist}/OnlineBanking.war" webxml="${web}/WEB-INF/web.xml">
            <!-- Add compiled classes -->
            <classes dir="${build}" />
            
            <!-- Add JSP files -->
            <fileset dir="${web}" />
            
            <!-- Add library files -->
            <lib dir="lib">
                <include name="*.jar" />
            </lib>
        </war>
        <echo message="WAR file built at ${dist}/OnlineBanking.war" />
    </target>

    <!-- NetBeans dist target (required for IDE integration) -->
    <target name="dist" depends="build" description="Build distribution package" />

    <!-- NetBeans compile target (required for IDE integration) -->
    <target name="all" depends="build" description="Build all artifacts" />

    <!-- Display help -->
    <target name="help" description="Display build help">
        <echo>
Available targets:
  - clean:   Remove all build artifacts
  - init:    Initialize build directories
  - compile: Compile Java source code
  - build:   Build WAR file for deployment (default)
  - help:    Display this help message
        </echo>
    </target>

</project>
